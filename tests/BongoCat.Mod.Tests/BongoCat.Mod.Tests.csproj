<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RequiresGameAssemblies>true</RequiresGameAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/BongoCat.Mod/BalanceMath.cs" Link="BalanceMath.cs" />
    <Compile Include="../../src/BongoCat.Mod/AutomationPolicy.cs" Link="AutomationPolicy.cs" />
    <Compile Include="../../src/BongoCat.Mod/ModSettings.cs" Link="ModSettings.cs" />
    <Compile Include="../../src/BongoCat.Mod/CosmeticPreferences.cs" Link="CosmeticPreferences.cs" />
    <Compile Include="../../src/BongoCat.Mod/MenuLayout.cs" Link="MenuLayout.cs" />
    <Compile Include="../../src/BongoCat.Mod/AutomationActivity.cs" Link="AutomationActivity.cs" />
    <Compile Include="../../src/BongoCat.Mod/FeatureCompatibility.cs" Link="FeatureCompatibility.cs" />
    <Compile Include="../../src/BongoCat.Mod/ApiContract.cs" Link="ApiContract.cs" />
    <Compile Include="../../src/BongoCat.Mod/GameApiContracts.cs" Link="GameApiContracts.cs" />
    <Compile Include="../../src/BongoCat.Mod/WheelLayout.cs" Link="WheelLayout.cs" />
    <Compile Include="../../src/BongoCat.Mod/ControlButtonArt.cs" Link="ControlButtonArt.cs" />
    <Reference Include="BepInEx"><HintPath>$(LoaderDirectory)/BepInEx.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDirectory)/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDirectory)/UnityEngine.dll</HintPath></Reference>
    <Reference Include="$(ManagedDirectory)/UnityEngine.*Module.dll" />
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDirectory)/Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="Heathen.Steamworks"><HintPath>$(ManagedDirectory)/Heathen.Steamworks.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedDirectory)/UnityEngine.UI.dll</HintPath></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(ManagedDirectory)/Unity.TextMeshPro.dll</HintPath></Reference>
    <Reference Include="com.rlabrecque.steamworks.net"><HintPath>$(ManagedDirectory)/com.rlabrecque.steamworks.net.dll</HintPath></Reference>
  </ItemGroup>
</Project>
